{
  "name": "cypress-test-store",
  "version": "1.0.0",
  "description": "Practica de automatizacion de pruebas",
  "author": "Acosta Ives",
  "type": "commonjs",
  "scripts": {
    "pruebas-chrome": "cypress run --spec cypress/e2e/smoketestae.cy.js --browser chrome",
    "pruebas-firefox": "cypress run --spec cypress/e2e/smoketestae.cy.js --browser firefox",
    "pruebas-api": "newman run postman/ae-api.postman_collection.json",
    "test": "npm run pruebas-chrome && npm run pruebas-api"
},
  "devDependencies": {
    "cypress": "^16.4.0",
    "newman": "^6.2.3"
  }
}
